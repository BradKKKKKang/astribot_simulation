#usda 1.0
(
    defaultPrim = "Enclosure"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Enclosure" (
    doc = "Penholder visual enclosure centered on the robot at world XY (0, 0). Clear interior: 2 x 2 m; ceiling underside: 2.2 m. Panels are visual only; the scene ground plane retains floor collision. One downward white strip light replaces the dome light."
)
{
    def "Looks"
    {
        def Material "MatteBlack"
        {
            token outputs:surface.connect = </Enclosure/Looks/MatteBlack/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "WhiteDiffuser"
        {
            token outputs:surface.connect = </Enclosure/Looks/WhiteDiffuser/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:emissiveColor = (1, 1, 1)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Cube "WallBack" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (0.05, 2.1, 2.2)
        double3 xformOp:translate = (-1.025, 0, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallFront" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (0.05, 2.1, 2.2)
        double3 xformOp:translate = (1.025, 0, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallLeft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (2, 0.05, 2.2)
        double3 xformOp:translate = (0, 1.025, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallRight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (2, 0.05, 2.2)
        double3 xformOp:translate = (0, -1.025, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (2.1, 2.1, 0.05)
        double3 xformOp:translate = (0, 0, 2.225)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "StripHousing" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (0.54, 0.16, 0.03)
        double3 xformOp:translate = (0, 0, 2.185)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "StripDiffuser" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/WhiteDiffuser>
        color3f[] primvars:displayColor = [(1, 1, 1)]
        double size = 1
        float3 xformOp:scale = (0.5, 0.12, 0.002)
        double3 xformOp:translate = (0, 0, 2.169)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def RectLight "CeilingStripLight" (
        doc = "Single 0.5 m x 0.12 m white area light above the robot, emitting downward (-Z). Moderate starting intensity 300, exposure 0; tune inputs:intensity for the active renderer/camera exposure."
    )
    {
        color3f inputs:color = (1, 1, 1)
        bool inputs:enableColorTemperature = 0
        float inputs:exposure = 0
        float inputs:height = 0.12
        float inputs:intensity = 300
        bool inputs:normalize = 0
        float inputs:width = 0.5
        double3 xformOp:translate = (0, 0, 2.165)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
