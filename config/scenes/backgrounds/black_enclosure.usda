#usda 1.0
(
    defaultPrim = "Enclosure"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Enclosure" (
    doc = "Black visual enclosure centered at world XY (0, 0). Clear interior: 3 x 3 m; ceiling underside: 2.2 m. Panels are visual only; the scene ground plane retains floor collision. A white ceiling strip and two soft front-side fill lights illuminate the arm joints and grippers; no dome light is required."
)
{
    def "Looks"
    {
        def Material "MatteBlack"
        {
            token outputs:surface.connect = </Enclosure/Looks/MatteBlack/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0, 0, 0)
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }

        def Material "WhiteDiffuser"
        {
            token outputs:surface.connect = </Enclosure/Looks/WhiteDiffuser/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                color3f inputs:emissiveColor = (1, 1, 1)
                float inputs:metallic = 0
                float inputs:roughness = 1
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Cube "WallBack" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (0.05, 3.1, 2.2)
        double3 xformOp:translate = (-1.525, 0, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallFront" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (0.05, 3.1, 2.2)
        double3 xformOp:translate = (1.525, 0, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallLeft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (3, 0.05, 2.2)
        double3 xformOp:translate = (0, 1.525, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallRight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (3, 0.05, 2.2)
        double3 xformOp:translate = (0, -1.525, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Ceiling" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (3.1, 3.1, 0.05)
        double3 xformOp:translate = (0, 0, 2.225)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "StripHousing" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/MatteBlack>
        color3f[] primvars:displayColor = [(0, 0, 0)]
        double size = 1
        float3 xformOp:scale = (0.54, 0.16, 0.03)
        double3 xformOp:translate = (0, 0, 2.185)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "StripDiffuser" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Enclosure/Looks/WhiteDiffuser>
        color3f[] primvars:displayColor = [(1, 1, 1)]
        double size = 1
        float3 xformOp:scale = (0.5, 0.12, 0.002)
        double3 xformOp:translate = (0, 0, 2.169)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def RectLight "CeilingStripLight" (
        doc = "0.5 m x 0.12 m white key light above the robot, emitting downward (-Z). Intensity 30000, exposure 0, complemented by the front-side fill lights."
    )
    {
        color3f inputs:color = (1, 1, 1)
        bool inputs:enableColorTemperature = 0
        float inputs:exposure = 0
        float inputs:height = 0.12
        float inputs:intensity = 30000
        bool inputs:normalize = 0
        float inputs:width = 0.5
        double3 xformOp:translate = (0, 0, 2.165)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def RectLight "FillRight" (
        doc = "Soft white fill directed at world (0.25, 0, 1.05), lighting arm joints and gripper sides."
    )
    {
        color3f inputs:color = (1, 1, 1)
        bool inputs:enableColorTemperature = 0
        float inputs:exposure = 0
        float inputs:height = 0.6
        float inputs:intensity = 8000
        bool inputs:normalize = 0
        float inputs:width = 0.8
        double3 xformOp:translate = (1.1, -1.1, 1.45)
        quatd xformOp:orient = (0.7560773669918278, 0.5692007693413534, 0.19429425677861634, 0.2580837869505979)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def RectLight "FillLeft" (
        doc = "Soft white fill directed at world (0.25, 0, 1.05), lighting arm joints and gripper sides."
    )
    {
        color3f inputs:color = (1, 1, 1)
        bool inputs:enableColorTemperature = 0
        float inputs:exposure = 0
        float inputs:height = 0.6
        float inputs:intensity = 8000
        bool inputs:normalize = 0
        float inputs:width = 0.8
        double3 xformOp:translate = (1.1, 1.1, 1.45)
        quatd xformOp:orient = (0.258083786950598, 0.19429425677861625, 0.5692007693413532, 0.7560773669918278)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }
}
